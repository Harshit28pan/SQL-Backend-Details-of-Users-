<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <style>
        table,th,td{
            border:1px solid black;
        }
        
    </style>
</head>
<body>
    <h2><u>Details Of All Users</u></h2>
    <table>
        <thead>
        <tr>
            <th>SR No.</th>
            <th>Id</th>
            <th>Email</th>
            <th>Username</th>
            <th>Edit Username</th>
            <th>Delete</th>
        </tr></thead>
        <% for(user of users) {  %>
            <tr>
                <td> <%= index++ %></td>
                <td> <%= user.id %></td>
                <td> <%= user.email %></td>
                <td> <%= user.username %> </td>
                <td><form method="get" action="/user/<%= user.id %>/edit">
                    <button>Edit Username</button>

                </form></td>
        <td><form method="get" action= "/user/<%=user.id %>/delete">
            <button>Delete</button>
        </form></td></tr>

        <% } %>

        <a href="http://localhost:8080/user/new">Add New User</a>
    </br>
</br>


    </table>
    
</body>
</html>